vertexlitgeneric

{
$baseTexture "models\infected\chargerconcept\chargerconceptdecals"
	"$detail" "models/infected/common/l4d2/ci_burning"

	"$bbqamount" "1"
	"$BurnLevel" "0"

	"Proxies"
	{
		"BBQLevel"
		{
			"resultVar" "$bbqamount"
		}
		"BurnLevel"
		{
			"resultVar" "$burnlevel"
		}
		"Equals"
		{
			"srcVar1" "$BurnLevel"
			"resultVar" "$detailblendfactor"
		}
	}
$nocull 1
$translucent 1
$lightwarptexture "models\survivors\coach\coach_head_wrp"
$halflambert 0
$diffuseexp 1
$bumpmap "models\infected\chargerconcept\chargerconceptdecalsnormal"
$phong 1
$phongboost 4
$phongexponent 30
$ambientocclusion 1
$phongtint "[0 0 0]"
$phongfresnelranges "[.1 .5 1]"
$allowdiffusemodulation 0
$ambientboost 0
$color2 "[1.5 1.5 1.5]"
}
